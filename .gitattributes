tests/fixtures/audio/* binary

# The module-list files. Parallel PRs each add one `pub mod` line to them. With
# the union merge driver a rebase keeps the lines of both sides and reports no
# conflict, and `cargo fmt` then orders them. The driver applies to the whole
# file, so `cargo xtask check` runs after a rebase.
src/lib.rs merge=union
src/api/mod.rs merge=union
src/db/queries/mod.rs merge=union
