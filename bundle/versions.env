# Pinned versions of everything in the release bundle. bundle/build.sh
# sources this file. internal/navidrome has a test that fails when
# NAVIDROME_VERSION differs from navidrome.PinnedVersion.

# Navidrome release (github.com/navidrome/navidrome), tag without the "v".
NAVIDROME_VERSION=0.64.2

# beets release on PyPI, installed with the chroma extra.
BEETS_VERSION=2.14.1

# Chromaprint release (github.com/acoustid/chromaprint) for fpcalc.
# The tarball sha256 is in bundle/checksums.
CHROMAPRINT_VERSION=1.6.2

# Python interpreter carried inside the beets executable, and the
# python-build-standalone release it comes from. The sha256 of the interpreter
# archive is in bundle/checksums. bundle/beets.lock must be recreated when
# BEETS_VERSION, PEX_VERSION, or the minor version of PYTHON_VERSION changes.
PYTHON_VERSION=3.13.16
PBS_RELEASE=20261013

# Build tools.
PEX_VERSION=2.103.4
UV_VERSION=0.13.1
